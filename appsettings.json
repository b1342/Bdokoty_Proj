{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=workshowcase_db;Username=postgres;Password=YOUR_PASSWORD"
  },
  "Jwt": {
    "Secret": "YOUR_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS",
    "Issuer": "WorkshowcaseApi",
    "Audience": "WorkshowcaseApiClient",
    "ExpiryMinutes": 60
  },
  "FileStorage": {
    "WorkMediaRootFolder": "wwwroot/uploads/work-media",
    "WorkMediaRequestPath": "/uploads/work-media",
    "MaxFileSizeBytes": 10485760,
    "AllowedImageExtensions": [".jpg", ".jpeg", ".png", ".webp"],
    "AllowedVideoExtensions": [".mp4", ".mov", ".webm"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}